---
// Testseite 4: About als dunkles Kapitel mit durchgehender Partikel-Bühne.
// Ein Partikelschwarm verwandelt sich von Screen zu Screen: Rauschen, Raster mit
// herausgelöster Form, Signalwelle, Gitter, steigende Kurve, Staub, Kopf.
// Die drei Säulen stehen auf eigenen Screens.
// Text aus Vault: Business/thiele.studio/Projects/website-relaunch-2026/content-structure.md
import Layout from "../layouts/Layout.astro";
import ParticleStory from "../components/ParticleStory.astro";

const cases = [
  { slug: "campany", title: "Campany Vans", cover: "/images/cases/campany/campany-01.png" },
  { slug: "qruise", title: "Qruise", cover: "/images/cases/qruise/qruise-00.jpg" },
  { slug: "wikinger", title: "Wikinger Reisen", cover: "/images/cases/wikinger/wikinger-case-01.png" },
  { slug: "anny-herbs", title: "Anny Herbs", cover: "/images/cases/anny-herbs/annyherbs-06.jpg" },
  { slug: "slow-supply", title: "Slow Supply", cover: "/images/cases/slow-supply/slowsupply-branding-00.jpg" },
  { slug: "wyldaway", title: "Wyldaway", cover: "/images/cases/wyldaway/wyldaway-brand-l-01.jpg" },
];

const pillars = [
  {
    title: "Differentiate or Die",
    body: "A clear strategic foundation determines whether you go with the flow or create your own direction. Whether you add to the noise or become a signal people recognize.",
  },
  {
    title: "Experience Elevation",
    body: "A brand is only as trustworthy as its worst touchpoint. A clear brand system, built from the inside out, lets your team deliver the quality people expect at every single one.",
  },
  {
    title: "Form Follows Fuckups",
    body: "The projects that have moved fastest are the ones we tested early, while changes were still cheap. Measurable outcomes build lasting impact and drive sustainable growth.",
  },
];

const services = [
  {
    title: "Brand Foundation",
    items: [
      "Brand Audit, Strategy & Architecture",
      "Brand Naming",
      "Visual Identity & Design Systems",
      "AI Guardrails & Guidelines",
    ],
  },
  {
    title: "Digital Product & Service Design",
    items: [
      "Creative Direction",
      "Service Innovation",
      "UX Research & Concept",
      "Product Design Systems",
      "Rapid Prototyping & Usability Testing",
    ],
  },
  {
    title: "Connection & Growth",
    items: [
      "Growth Marketing Strategy",
      "Campaign Ideation",
      "Analytics",
      "Fractional Leadership",
    ],
  },
];

const logoSlots = Array.from({ length: 8 });
---
<Layout>
  <section class="hero" id="work">
    <div class="hero-intro">
      <h1>Design that makes a difference in a way that makes sense.</h1>
    </div>

    <div class="case-grid">
      {
        cases.map((c, i) => {
          const speeds = [0.85, 1.18, 0.92, 1.12, 0.88, 1.15];
          return (
            <a
              href={`/projects/${c.slug}`}
              class={`item item-${i + 1}`}
              aria-label={c.title}
              data-speed={speeds[i]}
            >
              <img src={c.cover} alt={c.title} loading="eager" />
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="about" id="about">
    <ParticleStory />

    <div class="screen screen--intro" data-shape="noise">
      <div class="inner">
        <h2 class="about-headline" data-decode>Driving growth through clarity.</h2>
        <p class="about-support" data-reveal>
          I support startups and digital-native brands through strategic advisory,
          scalable brand foundations and design systems that reduce noise, raise
          trust and elevate sustainable growth.
        </p>
      </div>
      <div class="marquee" data-reveal aria-label="Logos Kunden und Projekte, Platzhalter">
        <div class="marquee-track" aria-hidden="true">
          {[0, 1].map(() => logoSlots.map(() => <span class="logo-slot small">Logo</span>))}
        </div>
      </div>
    </div>

    <div class="screen" data-shape="standout">
      <div class="inner">
        <p class="about-promise" data-rise>
          While looking good is free now, being chosen gets tougher. I help
          companies focus and decide what deserves to be heard, seen and
          understood. Then we make it unmistakable.
        </p>
      </div>
    </div>

    {
      pillars.map((p, i) => (
        <div class="screen" data-shape={["signal", "system", "growth"][i]}>
          <div class="inner">
            <div class="pillar" data-reveal>
              <p class="small label pillar-num">{`0${i + 1} / 03`}</p>
              <h3 class="pillar-title" data-decode>{p.title}</h3>
              <p class="pillar-body">{p.body}</p>
            </div>
          </div>
        </div>
      ))
    }

    <div class="screen" data-shape="dust">
      <div class="inner services">
        <p class="services-intro" data-reveal>
          Elevating brand experiences means removing friction and creating
          frameworks and narratives for meaningful customer relationships, while
          balancing user needs and business outcomes. Empathic, iterative,
          collaborative.
        </p>
        <ol class="services-groups">
          {
            services.map((s, i) => (
              <li class="service" data-reveal style={`--i:${i + 1}`}>
                <p class="small label">
                  <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
                  {s.title}
                </p>
                <ul class="service-list">
                  {s.items.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="screen" data-shape="head">
      <div class="inner">
        <p class="about-close" data-rise>
          Working with me gets you 20 years of experience, a network of trusted
          professionals &amp; no overhead.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // About als dunkles Kapitel: Sobald der About-Teil die Bildschirmmitte
  // erreicht, tauschen Hintergrund- und Textfarbe der ganzen Seite weich.
  const aboutSection = document.querySelector<HTMLElement>(".about");
  const syncDark = () => {
    if (!aboutSection) return;
    const dark = aboutSection.getBoundingClientRect().top < window.innerHeight * 0.5;
    document.documentElement.classList.toggle("about-dark", dark);
  };
  window.addEventListener("scroll", syncDark, { passive: true });
  window.addEventListener("resize", syncDark);
  syncDark();
</script>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const about = document.querySelector<HTMLElement>(".about");

  // ---------- Einblenden: Blöcke gleiten weich ein, Text steigt wortweise auf
  if (about && !reduce) {
    about.querySelectorAll<HTMLElement>("[data-rise]").forEach((el) => {
      const words = (el.textContent ?? "").trim().split(/\s+/);
      el.textContent = "";
      words.forEach((word, i) => {
        const w = document.createElement("span");
        w.className = "w";
        w.style.setProperty("--i", String(i));
        w.textContent = word;
        el.appendChild(w);
        if (i < words.length - 1) el.appendChild(document.createTextNode(" "));
      });
    });

    about.classList.add("anim");

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -5% 0px" }
    );
    about.querySelectorAll("[data-reveal], [data-rise]").forEach((el) => io.observe(el));
  }

  // ---------- Decode: Zeichenrauschen löst sich in den Text auf.
  // Takt wie der Hover-Scramble in Layout.astro. Jedes Zeichen bekommt eine
  // Zelle in seiner echten Breite, das Rauschen nimmt nur Glyphen ähnlicher
  // Breite. So bleibt die Wortform stehen und nichts läuft ineinander.
  const GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%*/·";
  const GLYPHS_LOWER = "abcdefghijklmnopqrstuvwxyz";
  const ALL = [...new Set(GLYPHS + GLYPHS_LOWER)];
  const TOTAL = 40;
  const TICK = 28;
  const FIT = 1.1;
  const MIN_FIT = 0.8;

  const isLower = (ch: string) => ch !== ch.toUpperCase();

  function initDecode(el: HTMLElement) {
    const original = (el.textContent ?? "").trim();
    const len = original.length;
    let started = false;
    let cells: { el: HTMLElement; ch: string; pool: string[] }[] = [];

    el.setAttribute("aria-label", original);

    const measureGlyphs = () => {
      const probe = document.createElement("span");
      probe.style.cssText = "position:absolute;visibility:hidden;white-space:pre";
      el.appendChild(probe);
      const widths = new Map<string, number>();
      for (const g of ALL) {
        probe.textContent = g;
        widths.set(g, probe.getBoundingClientRect().width);
      }
      probe.remove();
      return widths;
    };

    const poolFor = (ch: string, cellW: number, widths: Map<string, number>) => {
      const primary = [...(isLower(ch) ? GLYPHS_LOWER : GLYPHS)];
      const fits = (g: string) => {
        const w = widths.get(g) ?? Infinity;
        return w >= cellW * MIN_FIT && w <= cellW * FIT;
      };
      let pool = primary.filter(fits);
      if (pool.length < 3) pool = ALL.filter(fits);
      if (pool.length < 3) {
        pool = [...ALL]
          .sort((x, y) => Math.abs((widths.get(x) ?? 0) - cellW) - Math.abs((widths.get(y) ?? 0) - cellW))
          .slice(0, 4);
      }
      return pool;
    };

    const lock = () => {
      el.textContent = original;
      const node = el.firstChild as Text;
      const range = document.createRange();
      const charW: number[] = [];
      for (let i = 0; i < len; i++) {
        range.setStart(node, i);
        range.setEnd(node, i + 1);
        charW.push(range.getBoundingClientRect().width);
      }
      const widths = measureGlyphs();

      el.textContent = "";
      cells = [];
      let i = 0;
      original.split(" ").forEach((word, wi, arr) => {
        const w = document.createElement("span");
        w.className = "dw";
        w.setAttribute("aria-hidden", "true");
        for (const ch of word) {
          const c = document.createElement("span");
          c.className = "dc";
          c.style.width = `${charW[i]}px`;
          c.textContent = ch;
          w.appendChild(c);
          cells.push({ el: c, ch, pool: /[.,:]/.test(ch) ? [ch] : poolFor(ch, charW[i], widths) });
          i++;
        }
        el.appendChild(w);
        if (wi < arr.length - 1) {
          el.appendChild(document.createTextNode(" "));
          i++;
        }
      });
    };

    const render = (frame: number) => {
      let idx = 0;
      let ci = 0;
      for (const ch of original) {
        if (ch !== " ") {
          const cell = cells[ci++];
          const revealAt = (idx / len) * TOTAL * 0.7;
          cell.el.textContent = frame >= revealAt
            ? cell.ch
            : cell.pool[(Math.random() * cell.pool.length) | 0];
        }
        idx++;
      }
    };

    const run = () => {
      started = true;
      let frame = 0;
      const timer = window.setInterval(() => {
        frame++;
        render(frame);
        if (frame >= TOTAL) {
          window.clearInterval(timer);
          el.textContent = original;
        }
      }, TICK);
    };

    lock();
    render(-1);

    window.addEventListener("resize", () => {
      if (started) return;
      lock();
      render(-1);
    });

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          run();
        }
      },
      { threshold: 0.6 }
    );
    io.observe(el);
  }

  if (!reduce) {
    document.fonts.ready.then(() => {
      document.querySelectorAll<HTMLElement>("[data-decode]").forEach(initDecode);
    });
  }
</script>

<style>
  .hero {
    padding: calc(var(--pad) * 3) var(--edge) var(--pad);
  }

  .hero-intro {
    margin: 0 0 calc(var(--pad) * 2);
  }

  .hero-intro h1 {
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: auto;
    column-gap: var(--gap);
    row-gap: calc(var(--gap) * 2);
    align-items: start;
  }

  .item {
    display: block;
    overflow: hidden;
  }

  .item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .item:hover img {
    transform: scale(1.02);
  }

  .item-1 { grid-column: 1 / span 7;  grid-row: 1; }
  .item-2 { grid-column: 9 / span 4;  grid-row: 1; margin-top: calc(var(--gap) * 2); }
  .item-3 { grid-column: 2 / span 5;  grid-row: 2; margin-top: calc(var(--gap) * 3); }
  .item-4 { grid-column: 8 / span 5;  grid-row: 2; }
  .item-5 { grid-column: 1 / span 7;  grid-row: 3; }
  .item-6 { grid-column: 9 / span 4;  grid-row: 3; margin-top: calc(var(--gap) * 2); }

  :global(html),
  :global(body) {
    transition:
      background-color 0.9s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(html.about-dark) {
    --color-bg: #111;
    --color-fg: #f7f4ec;
    --color-muted: #8a8780;
  }

  :global(html.about-dark .site-footer) {
    border-top-color: rgba(247, 244, 236, 0.12);
  }

  /* About in Screens: jeder Abschnitt nimmt eine Bildschirmhöhe ein.
     laut  = Headline (--fs-h1) und Versprechen (--fs-h2), ab Spalte 1
     leise = Begleittext (--fs-body), rechte Hälfte ab Spalte 7 */
  .about {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
  }

  .screen {
    position: relative;
    z-index: 1;
  }

  .screen {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--pad) * 2);
    padding: calc(var(--pad) * 2) 0;
  }

  .inner {
    width: 100%;
    padding: 0 var(--edge);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gap);
    row-gap: var(--gap);
  }

  .screen--intro .inner {
    margin-top: auto;
  }

  .about-headline {
    grid-column: 1 / -1;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .about-headline :global(.dw) {
    white-space: nowrap;
  }

  .about-headline :global(.dc) {
    display: inline-block;
    text-align: center;
    letter-spacing: 0;
  }

  .about-promise {
    grid-column: 1 / span 7;
    font-size: var(--fs-h2);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .about-support {
    grid-column: 1 / span 5;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Logo-Laufband, randlos */
  .marquee {
    margin-top: auto;
    overflow: hidden;
    padding: var(--gap) 0;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .logo-slot {
    flex-shrink: 0;
    width: 160px;
    height: 64px;
    margin-right: var(--gap);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--color-muted);
    color: var(--color-muted);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .pillar {
    grid-column: 1 / span 5;
  }

  .pillar-num {
    margin-bottom: var(--gap);
  }

  .pillar-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--gap);
  }

  .pillar-title :global(.dw) {
    white-space: nowrap;
  }

  .pillar-title :global(.dc) {
    display: inline-block;
    text-align: center;
    letter-spacing: 0;
  }

  .pillar-body {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }



  .label {
    color: var(--color-muted);
    margin-bottom: calc(var(--gap) * 0.5);
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-list li {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Leistungen nach dem Muster von the-echo-book.com:
     links bleibt die Einleitung stehen, rechts laufen die Gruppen durch.
     Beide Spalten starten auf derselben Höhe. */
  .services {
    align-items: start;
  }

  .services-intro {
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(var(--pad) * 3);
    font-size: var(--fs-h3);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .services-groups {
    grid-column: 7 / span 6;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .service-num {
    display: inline-block;
    min-width: calc(var(--gap) * 0.5);
    margin-right: calc(var(--gap) * 0.5);
  }

  .about-close {
    grid-column: 1 / span 7;
    font-size: var(--fs-h2);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* Bewegung, nur wenn das Script .anim setzt. Der Übergang hängt am
     Einblenden (.is-in), das Ausblenden beim Start passiert sofort. */
  .about.anim [data-reveal] {
    opacity: 0;
    transform: translateY(40px);
  }

  .about.anim [data-reveal].is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: calc(var(--i, 0) * 120ms);
  }

  .about.anim [data-rise] :global(.w) {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.35em);
  }

  .about.anim [data-rise].is-in :global(.w) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: calc(var(--i) * 35ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--pad) * 4);
    }

    .hero-intro {
      margin-bottom: var(--gap);
    }

    .case-grid {
      display: flex;
      flex-direction: column;
      gap: var(--gap);
    }

    .item-1,
    .item-2,
    .item-3,
    .item-4,
    .item-5,
    .item-6 {
      grid-column: auto;
      grid-row: auto;
      width: 100%;
      margin-top: 0;
      transform: none !important;
    }

    .screen {
      gap: var(--pad);
    }

    .inner {
      grid-template-columns: 1fr;
    }

    .about-headline,
    .about-promise,
    .about-support,
    .pillar,
    .services-intro,
    .services-groups,
    .about-close {
      grid-column: 1 / -1;
    }

    .pillar-body {
      font-size: var(--fs-body);
      line-height: var(--lh-body);
    }

    .services-intro {
      position: static;
      font-size: var(--fs-body);
      line-height: var(--lh-body);
    }

    .about-promise,
    .about-close {
      font-size: var(--fs-h3);
      line-height: 1.2;
    }

    .logo-slot {
      width: 120px;
      height: 48px;
    }
  }
</style>
