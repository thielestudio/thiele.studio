---
// Testseite: Home mit anschließender About-Sektion (eine Seite statt zwei).
// Text aus Vault: Business/thiele.studio/Projects/website-relaunch-2026/content-structure.md
import Layout from "../layouts/Layout.astro";

const cases = [
  { slug: "campany", title: "Campany Vans", cover: "/images/cases/campany/campany-01.png" },
  { slug: "qruise", title: "Qruise", cover: "/images/cases/qruise/qruise-00.jpg" },
  { slug: "wikinger", title: "Wikinger Reisen", cover: "/images/cases/wikinger/wikinger-case-01.png" },
  { slug: "anny-herbs", title: "Anny Herbs", cover: "/images/cases/anny-herbs/annyherbs-06.jpg" },
  { slug: "slow-supply", title: "Slow Supply", cover: "/images/cases/slow-supply/slowsupply-branding-00.jpg" },
  { slug: "wyldaway", title: "Wyldaway", cover: "/images/cases/wyldaway/wyldaway-brand-l-01.jpg" },
];

const pillars = [
  {
    title: "Differentiate or Die",
    body: "A clear strategic foundation determines whether you merely go with the flow or truly stand out. Signal or noise. Your customers either look at you or straight through you.",
  },
  {
    title: "Experience Elevation",
    body: "Since everyone is looking good now, your brand's look and feel must be exceptional. That's where I raise the bar and find what sets you apart.",
  },
  {
    title: "Form Follows Fuckups",
    body: "The projects that sparked fast are the ones that failed early, while it was still cheap to change. Measurable outcomes build lasting impact and elevate sustainable growth.",
  },
];

const services = [
  {
    title: "Brand Foundation",
    items: [
      "Brand Audit, Strategy & Architecture",
      "Brand Naming",
      "Visual Identity & Design Systems",
      "AI Guardrails & Guidelines",
    ],
  },
  {
    title: "Digital Product & Service Design",
    items: [
      "Creative Direction",
      "Service Innovation",
      "UX Research & Concept",
      "Product Design Systems",
      "Rapid Prototyping & Usability Testing",
    ],
  },
  {
    title: "Connection & Growth",
    items: [
      "Growth Marketing Strategy",
      "Campaign Ideation",
      "Analytics",
      "Fractional Leadership",
    ],
  },
];
---

<Layout>
  <section class="hero" id="work">
    <div class="hero-intro">
      <h1>Design that makes a difference in a way that makes sense.</h1>
    </div>

    <div class="case-grid">
      {
        cases.map((c, i) => {
          const speeds = [0.85, 1.18, 0.92, 1.12, 0.88, 1.15];
          return (
            <a
              href={`/projects/${c.slug}`}
              class={`item item-${i + 1}`}
              aria-label={c.title}
              data-speed={speeds[i]}
            >
              <img src={c.cover} alt={c.title} loading="eager" />
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-row">
      <h2 class="about-headline">Driving growth through clarity.</h2>
      <p class="about-lede">
        I support startups and digital-native brands through strategic advisory,
        scalable brand foundations and design systems that reduce noise, raise
        trust and elevate sustainable growth.
      </p>
    </div>

    <div class="about-row">
      <div class="logos-placeholder">
        <span class="small">Logos Kunden &amp; Projekte</span>
      </div>
    </div>

    <div class="about-row">
      <p class="about-lede">
        Modern markets are complex and blurry. I help companies to focus and
        decide what deserves to be heard, seen and understood. Then we make it
        unmistakable.
      </p>
    </div>

    <div class="about-row about-cols">
      {
        pillars.map((p) => (
          <div class="col">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="about-row">
      <p class="about-lede">
        Elevating brand experiences means removing friction and creating
        frameworks and narratives for meaningful customer relationships, while
        balancing user needs and business outcomes. Empathic, iterative,
        collaborative.
      </p>
    </div>

    <div class="about-row about-cols">
      {
        services.map((s) => (
          <div class="col">
            <p class="small label">{s.title}</p>
            <ul class="service-list">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="about-row">
      <p class="about-close">
        Working with me gets you 20 years of experience, a network of trusted
        professionals &amp; no overhead.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: calc(var(--pad) * 3) var(--pad) var(--pad);
  }

  .hero-intro {
    max-width: 1400px;
    margin: 0 auto calc(var(--pad) * 2);
  }

  .hero-intro h1 {
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .case-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: auto;
    column-gap: var(--gap);
    row-gap: calc(var(--gap) * 2);
    align-items: start;
  }

  .item {
    display: block;
    overflow: hidden;
  }

  .item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .item:hover img {
    transform: scale(1.02);
  }

  .item-1 { grid-column: 1 / span 7;  grid-row: 1; }
  .item-2 { grid-column: 9 / span 4;  grid-row: 1; margin-top: calc(var(--gap) * 2); }
  .item-3 { grid-column: 2 / span 5;  grid-row: 2; margin-top: calc(var(--gap) * 3); }
  .item-4 { grid-column: 8 / span 5;  grid-row: 2; }
  .item-5 { grid-column: 1 / span 7;  grid-row: 3; }
  .item-6 { grid-column: 9 / span 4;  grid-row: 3; margin-top: calc(var(--gap) * 2); }

  /* About: Hierarchie aus dem Draft
     #  -> --fs-h1, ## -> --fs-h2, fett -> h3, Fließtext -> --fs-body */
  .about {
    max-width: 1400px;
    margin: 0 auto;
    padding: calc(var(--pad) * 4) var(--pad);
    display: flex;
    flex-direction: column;
    gap: calc(var(--pad) * 3);
  }

  .about-row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gap);
    row-gap: calc(var(--gap) * 1.5);
  }

  .about-headline {
    grid-column: 1 / span 10;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .about-lede {
    grid-column: 1 / span 10;
    font-size: var(--fs-h2);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .about-headline + .about-lede {
    margin-top: calc(var(--gap) * -0.5);
  }

  .logos-placeholder {
    grid-column: 1 / -1;
    border: 1px dashed var(--color-muted);
    color: var(--color-muted);
    padding: calc(var(--pad) * 1.5) var(--pad);
    text-align: center;
  }

  .about-cols .col {
    grid-column: span 4;
  }

  .about-cols h3 {
    margin-bottom: calc(var(--gap) * 0.5);
  }

  .about-cols p:not(.label) {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .label {
    color: var(--color-muted);
    margin-bottom: calc(var(--gap) * 0.5);
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-list li {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .about-close {
    grid-column: 1 / span 8;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--pad) * 4);
    }

    .hero-intro {
      margin-bottom: var(--gap);
    }

    .case-grid {
      display: flex;
      flex-direction: column;
      gap: var(--gap);
    }

    .item-1,
    .item-2,
    .item-3,
    .item-4,
    .item-5,
    .item-6 {
      grid-column: auto;
      grid-row: auto;
      width: 100%;
      margin-top: 0;
      transform: none !important;
    }

    .about {
      padding: calc(var(--pad) * 2) var(--pad);
      gap: calc(var(--pad) * 2);
    }

    .about-row {
      grid-template-columns: 1fr;
    }

    .about-headline,
    .about-lede,
    .about-cols .col,
    .logos-placeholder,
    .about-close {
      grid-column: 1 / -1;
    }

    .about-lede {
      font-size: var(--fs-h3);
      line-height: 1.2;
    }

    .about-headline + .about-lede {
      margin-top: 0;
    }
  }
</style>
