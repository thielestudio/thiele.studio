---
// Testseite 2: wie index-test, plus Hierarchie auf zwei laute Aussagen
// und Decode-Effekt auf der About-Headline beim Reinscrollen.
// Text aus Vault: Business/thiele.studio/Projects/website-relaunch-2026/content-structure.md
import Layout from "../layouts/Layout.astro";

const cases = [
  { slug: "campany", title: "Campany Vans", cover: "/images/cases/campany/campany-01.png" },
  { slug: "qruise", title: "Qruise", cover: "/images/cases/qruise/qruise-00.jpg" },
  { slug: "wikinger", title: "Wikinger Reisen", cover: "/images/cases/wikinger/wikinger-case-01.png" },
  { slug: "anny-herbs", title: "Anny Herbs", cover: "/images/cases/anny-herbs/annyherbs-06.jpg" },
  { slug: "slow-supply", title: "Slow Supply", cover: "/images/cases/slow-supply/slowsupply-branding-00.jpg" },
  { slug: "wyldaway", title: "Wyldaway", cover: "/images/cases/wyldaway/wyldaway-brand-l-01.jpg" },
];

const pillars = [
  {
    title: "Differentiate or Die",
    body: "A clear strategic foundation determines whether you merely go with the flow or truly stand out. Signal or noise. Your customers either look at you or straight through you.",
  },
  {
    title: "Experience Elevation",
    body: "Since everyone is looking good now, your brand's look and feel must be exceptional. That's where I raise the bar and find what sets you apart.",
  },
  {
    title: "Form Follows Fuckups",
    body: "The projects that sparked fast are the ones that failed early, while it was still cheap to change. Measurable outcomes build lasting impact and elevate sustainable growth.",
  },
];

const services = [
  {
    title: "Brand Foundation",
    items: [
      "Brand Audit, Strategy & Architecture",
      "Brand Naming",
      "Visual Identity & Design Systems",
      "AI Guardrails & Guidelines",
    ],
  },
  {
    title: "Digital Product & Service Design",
    items: [
      "Creative Direction",
      "Service Innovation",
      "UX Research & Concept",
      "Product Design Systems",
      "Rapid Prototyping & Usability Testing",
    ],
  },
  {
    title: "Connection & Growth",
    items: [
      "Growth Marketing Strategy",
      "Campaign Ideation",
      "Analytics",
      "Fractional Leadership",
    ],
  },
];
---

<Layout>
  <section class="hero" id="work">
    <div class="hero-intro">
      <h1>Design that makes a difference in a way that makes sense.</h1>
    </div>

    <div class="case-grid">
      {
        cases.map((c, i) => {
          const speeds = [0.85, 1.18, 0.92, 1.12, 0.88, 1.15];
          return (
            <a
              href={`/projects/${c.slug}`}
              class={`item item-${i + 1}`}
              aria-label={c.title}
              data-speed={speeds[i]}
            >
              <img src={c.cover} alt={c.title} loading="eager" />
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-row">
      <h2 class="about-headline" data-decode>Driving growth through clarity.</h2>
      <p class="about-support">
        I support startups and digital-native brands through strategic advisory,
        scalable brand foundations and design systems that reduce noise, raise
        trust and elevate sustainable growth.
      </p>
    </div>

    <div class="about-row">
      <div class="logos-placeholder">
        <span class="small">Logos Kunden &amp; Projekte</span>
      </div>
    </div>

    <div class="about-row">
      <p class="about-promise">
        Modern markets are complex and blurry. I help companies to focus and
        decide what deserves to be heard, seen and understood. Then we make it
        unmistakable.
      </p>
    </div>

    <div class="about-row about-cols">
      {
        pillars.map((p) => (
          <div class="col">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="about-row">
      <p class="about-support">
        Elevating brand experiences means removing friction and creating
        frameworks and narratives for meaningful customer relationships, while
        balancing user needs and business outcomes. Empathic, iterative,
        collaborative.
      </p>
    </div>

    <div class="about-row about-cols">
      {
        services.map((s) => (
          <div class="col">
            <p class="small label">{s.title}</p>
            <ul class="service-list">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="about-row">
      <p class="about-close">
        Working with me gets you 20 years of experience, a network of trusted
        professionals &amp; no overhead.
      </p>
    </div>
  </section>
</Layout>

<script>
  // Decode: Die About-Headline steht als Zeichenrauschen da und löst sich
  // beim Reinscrollen in den Text auf. Takt wie der Hover-Scramble in
  // Layout.astro. Jedes Zeichen bekommt eine Zelle in seiner echten Breite,
  // und das Rauschen nimmt nur Glyphen, die in diese Zelle passen. So bleibt
  // die Silhouette der Wörter stehen und nichts läuft ineinander.
  const GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%*/·";
  const GLYPHS_LOWER = "abcdefghijklmnopqrstuvwxyz";
  const TOTAL = 40;
  const TICK = 28;
  const FIT = 1.1;
  const MIN_FIT = 0.8;

  const el = document.querySelector<HTMLElement>("[data-decode]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && !reduce) {
    const original = (el.textContent ?? "").trim();
    const len = original.length;
    let started = false;
    let cells: { el: HTMLElement; ch: string; pool: string[] }[] = [];

    el.setAttribute("aria-label", original);

    const isLower = (ch: string) => ch !== ch.toUpperCase();

    // Breite jeder Glyphe im echten Schnitt messen
    const measureGlyphs = () => {
      const probe = document.createElement("span");
      probe.style.cssText = "position:absolute;visibility:hidden;white-space:pre";
      el.appendChild(probe);
      const widths = new Map<string, number>();
      for (const g of new Set(GLYPHS + GLYPHS_LOWER)) {
        probe.textContent = g;
        widths.set(g, probe.getBoundingClientRect().width);
      }
      probe.remove();
      return widths;
    };

    // Nur Glyphen ähnlicher Breite: zu breite laufen ineinander,
    // zu schmale reißen Löcher in die Wortform.
    const poolFor = (ch: string, cellW: number, widths: Map<string, number>) => {
      const primary = [...(isLower(ch) ? GLYPHS_LOWER : GLYPHS)];
      const all = [...new Set(GLYPHS + GLYPHS_LOWER)];
      const fits = (g: string) => {
        const w = widths.get(g) ?? Infinity;
        return w >= cellW * MIN_FIT && w <= cellW * FIT;
      };
      let pool = primary.filter(fits);
      if (pool.length < 3) pool = all.filter(fits);
      if (pool.length < 3) {
        pool = all
          .sort((x, y) => Math.abs((widths.get(x) ?? 0) - cellW) - Math.abs((widths.get(y) ?? 0) - cellW))
          .slice(0, 4);
      }
      return pool;
    };

    const lock = () => {
      el.textContent = original;
      const node = el.firstChild as Text;
      const range = document.createRange();
      const charW: number[] = [];
      for (let i = 0; i < len; i++) {
        range.setStart(node, i);
        range.setEnd(node, i + 1);
        charW.push(range.getBoundingClientRect().width);
      }
      const widths = measureGlyphs();

      el.textContent = "";
      cells = [];
      let i = 0;
      original.split(" ").forEach((word, wi, arr) => {
        const w = document.createElement("span");
        w.className = "dw";
        w.setAttribute("aria-hidden", "true");
        for (const ch of word) {
          const c = document.createElement("span");
          c.className = "dc";
          c.style.width = `${charW[i]}px`;
          c.textContent = ch;
          w.appendChild(c);
          cells.push({ el: c, ch, pool: ch === "." ? [ch] : poolFor(ch, charW[i], widths) });
          i++;
        }
        el.appendChild(w);
        if (wi < arr.length - 1) {
          el.appendChild(document.createTextNode(" "));
          i++;
        }
      });
    };

    const render = (frame: number) => {
      let idx = 0;
      let ci = 0;
      for (const ch of original) {
        if (ch !== " ") {
          const cell = cells[ci++];
          const revealAt = (idx / len) * TOTAL * 0.7;
          cell.el.textContent = frame >= revealAt
            ? cell.ch
            : cell.pool[(Math.random() * cell.pool.length) | 0];
        }
        idx++;
      }
    };

    const run = () => {
      started = true;
      let frame = 0;
      const timer = window.setInterval(() => {
        frame++;
        render(frame);
        if (frame >= TOTAL) {
          window.clearInterval(timer);
          el.textContent = original;
        }
      }, TICK);
    };

    document.fonts.ready.then(() => {
      lock();
      render(-1);

      window.addEventListener("resize", () => {
        if (started) return;
        lock();
        render(-1);
      });

      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            run();
          }
        },
        { threshold: 0.6 }
      );
      io.observe(el);
    });
  }
</script>

<style>
  .hero {
    padding: calc(var(--pad) * 3) var(--pad) var(--pad);
  }

  .hero-intro {
    max-width: 1400px;
    margin: 0 auto calc(var(--pad) * 2);
  }

  .hero-intro h1 {
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .case-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: auto;
    column-gap: var(--gap);
    row-gap: calc(var(--gap) * 2);
    align-items: start;
  }

  .item {
    display: block;
    overflow: hidden;
  }

  .item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .item:hover img {
    transform: scale(1.02);
  }

  .item-1 { grid-column: 1 / span 7;  grid-row: 1; }
  .item-2 { grid-column: 9 / span 4;  grid-row: 1; margin-top: calc(var(--gap) * 2); }
  .item-3 { grid-column: 2 / span 5;  grid-row: 2; margin-top: calc(var(--gap) * 3); }
  .item-4 { grid-column: 8 / span 5;  grid-row: 2; }
  .item-5 { grid-column: 1 / span 7;  grid-row: 3; }
  .item-6 { grid-column: 9 / span 4;  grid-row: 3; margin-top: calc(var(--gap) * 2); }

  /* About, zwei Stimmen:
     laut  = Headline (--fs-h1) und Versprechen (--fs-h2), ab Spalte 1
     leise = Begleittext (--fs-body), rechte Hälfte ab Spalte 7 */
  .about {
    max-width: 1400px;
    margin: 0 auto;
    padding: calc(var(--pad) * 4) var(--pad);
    display: flex;
    flex-direction: column;
    gap: calc(var(--pad) * 3);
  }

  .about-row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gap);
    row-gap: calc(var(--gap) * 1.5);
  }

  .about-headline {
    grid-column: 1 / -1;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .about-headline :global(.dw) {
    white-space: nowrap;
  }

  .about-headline :global(.dc) {
    display: inline-block;
    text-align: center;
    letter-spacing: 0;
  }

  .about-promise {
    grid-column: 1 / span 10;
    font-size: var(--fs-h2);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .about-support {
    grid-column: 7 / span 6;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .logos-placeholder {
    grid-column: 1 / -1;
    border: 1px dashed var(--color-muted);
    color: var(--color-muted);
    padding: calc(var(--pad) * 1.5) var(--pad);
    text-align: center;
  }

  .about-cols .col {
    grid-column: span 4;
  }

  .about-cols h3 {
    margin-bottom: calc(var(--gap) * 0.5);
  }

  .about-cols p:not(.label) {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .label {
    color: var(--color-muted);
    margin-bottom: calc(var(--gap) * 0.5);
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-list li {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .about-close {
    grid-column: 1 / span 8;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--pad) * 4);
    }

    .hero-intro {
      margin-bottom: var(--gap);
    }

    .case-grid {
      display: flex;
      flex-direction: column;
      gap: var(--gap);
    }

    .item-1,
    .item-2,
    .item-3,
    .item-4,
    .item-5,
    .item-6 {
      grid-column: auto;
      grid-row: auto;
      width: 100%;
      margin-top: 0;
      transform: none !important;
    }

    .about {
      padding: calc(var(--pad) * 2) var(--pad);
      gap: calc(var(--pad) * 2);
    }

    .about-row {
      grid-template-columns: 1fr;
    }

    .about-headline,
    .about-promise,
    .about-support,
    .about-cols .col,
    .logos-placeholder,
    .about-close {
      grid-column: 1 / -1;
    }

    .about-promise {
      font-size: var(--fs-h3);
      line-height: 1.2;
    }
  }
</style>
