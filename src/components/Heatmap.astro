---
// Heatmap als Hintergrund: Wo die Maus sich bewegt, verweilt oder klickt, wird
// die Seite warm, wie in einem Klick- und Bewegungsprotokoll. Die Wärme hängt an
// der Seite, nicht am Bildschirm: sie scrollt mit dem Text mit.
// Technik: Wärmewerte der ganzen Seite in Viertelauflösung als Zahlenfeld, in das
// weiche Flecken addiert werden; sichtbar ist nur der Ausschnitt im Fenster, dessen
// Wärme über eine Farbskala in Pinktönen um #DE4B97 eingefärbt wird.
// Abkühlen = anteilig plus fester Abzug, damit schwache Reste ganz verschwinden
// statt als heller Schleier stehen zu bleiben (Daniel, 03.11.2026).
// Unten links Umschalter fürs Abkühlen, nur zum Testen.
// Stand 03.11.2026, Test auf Testseite 8.
---

<canvas class="heatmap" data-heatmap aria-hidden="true"></canvas>
<div class="heat-switch" data-heat-switch>
  <span>Abkühlen</span>
  <button type="button" data-decay="fast">schnell</button>
  <button type="button" data-decay="slow" class="is-on">langsam</button>
  <button type="button" data-decay="off">nie</button>
  <button type="button" data-clear>leeren</button>
</div>

<script>
  const view = document.querySelector<HTMLCanvasElement>("[data-heatmap]")!;
  const S = 4; // Auflösung: 1 Feld = 4 × 4 Bildschirmpixel
  const R = 64; // px Radius eines Flecks
  const MOVE = 0.05; // Wärme je Fleck bei Bewegung
  const DWELL = 0.012; // je Bild, solange die Maus ruht
  const CLICK = 0.35;
  const CUT = 0.05; // darunter unsichtbar
  // je Bild: Wärme × keep − drop
  const DECAY = {
    fast: { keep: 0.985, drop: 0.004 },
    slow: { keep: 0.996, drop: 0.0025 },
    off: { keep: 1, drop: 0 },
  } as const;
  let decay: { keep: number; drop: number } = DECAY.slow;

  // Farbe je Wärmestufe: Index = Wärme 0–255
  const lut = (() => {
    const c = document.createElement("canvas");
    c.width = 256;
    c.height = 1;
    const x = c.getContext("2d")!;
    const g = x.createLinearGradient(0, 0, 256, 0);
    // Pinktöne um #DE4B97 statt Orange/Gelb (Daniel, 04.11.2026), aufgebaut wie
    // die klassische Skala: kühl blass, mittel #DE4B97, heiß hell und leuchtend
    g.addColorStop(0, "rgba(240,170,205,0)");
    g.addColorStop(0.12, "rgba(238,160,200,0.35)");
    g.addColorStop(0.4, "rgba(222,75,151,0.8)");
    g.addColorStop(0.72, "rgba(255,90,175,0.95)");
    g.addColorStop(1, "rgba(255,170,215,1)");
    x.fillStyle = g;
    x.fillRect(0, 0, 256, 1);
    return x.getImageData(0, 0, 256, 1).data;
  })();

  // weicher Fleck als Gewichte, einmal vorberechnet
  const dr = Math.ceil(R / S);
  const kSize = dr * 2 + 1;
  const kernel = new Float32Array(kSize * kSize);
  for (let y = 0; y < kSize; y++)
    for (let x = 0; x < kSize; x++) {
      const d = Math.hypot(x - dr, y - dr) / dr;
      kernel[y * kSize + x] = d < 1 ? (1 - d * d) ** 2 : 0;
    }

  // Wärmefeld der ganzen Seite
  let hw = 0;
  let hh = 0;
  let heat = new Float32Array(0);
  const vx = view.getContext("2d")!;
  let img: ImageData;

  const fit = () => {
    const w = Math.ceil(document.documentElement.scrollWidth / S);
    const h = Math.ceil(document.documentElement.scrollHeight / S);
    if (w !== hw || h !== hh) {
      const next = new Float32Array(w * h);
      for (let y = 0; y < Math.min(h, hh); y++)
        next.set(heat.subarray(y * hw, y * hw + Math.min(w, hw)), y * w);
      heat = next;
      hw = w;
      hh = h;
    }
    // eine Zeile mehr, damit Bruchteile beim Scrollen per Verschiebung gehen
    view.width = Math.ceil(innerWidth / S);
    view.height = Math.ceil(innerHeight / S) + 1;
    view.style.height = `${view.height * S}px`;
    img = vx.createImageData(view.width, view.height);
    dirty = true;
  };

  const stamp = (cx: number, cy: number, a: number) => {
    const gx = Math.round((cx + scrollX) / S) - dr;
    const gy = Math.round((cy + scrollY) / S) - dr;
    for (let y = 0; y < kSize; y++) {
      const hy = gy + y;
      if (hy < 0 || hy >= hh) continue;
      for (let x = 0; x < kSize; x++) {
        const hxp = gx + x;
        if (hxp < 0 || hxp >= hw) continue;
        const k = kernel[y * kSize + x] * a;
        if (!k) continue;
        const i = hy * hw + hxp;
        heat[i] += k * (1 - heat[i]); // sättigt bei 1
      }
    }
    dirty = true;
  };

  let px = -1;
  let py = -1;
  let dirty = true;
  let lastScroll = -1;

  addEventListener(
    "pointermove",
    (e) => {
      if (px >= 0) {
        // Zwischenpunkte, damit schnelle Züge eine Spur ergeben statt Punkte
        const d = Math.hypot(e.clientX - px, e.clientY - py);
        const n = Math.min(20, Math.floor(d / (R / 3)));
        for (let i = 1; i <= n; i++)
          stamp(px + ((e.clientX - px) * i) / (n + 1), py + ((e.clientY - py) * i) / (n + 1), MOVE);
      }
      px = e.clientX;
      py = e.clientY;
      stamp(px, py, MOVE);
    },
    { passive: true },
  );
  addEventListener("pointerdown", (e) => stamp(e.clientX, e.clientY, CLICK), { passive: true });
  document.documentElement.addEventListener("mouseleave", () => (px = py = -1));
  addEventListener("pointerup", (e) => {
    if (e.pointerType !== "mouse") px = py = -1;
  });

  const tick = () => {
    // Verweilen: ruhende Maus wärmt weiter, auch beim Scrollen unter ihr
    if (px >= 0) stamp(px, py, DWELL);
    if (decay.drop) {
      const { keep, drop } = decay;
      for (let i = 0; i < heat.length; i++) {
        const v = heat[i];
        if (v) heat[i] = v * keep - drop > 0 ? v * keep - drop : 0;
      }
      dirty = true;
    }
    if (dirty || scrollY !== lastScroll) {
      dirty = false;
      lastScroll = scrollY;
      const w = view.width;
      const h = view.height;
      const ox = Math.floor(scrollX / S);
      const oy = Math.floor(scrollY / S);
      view.style.transform = `translateY(${-(scrollY - oy * S)}px)`;
      const p = img.data;
      for (let y = 0; y < h; y++) {
        const hy = oy + y;
        for (let x = 0; x < w; x++) {
          const o = (y * w + x) * 4;
          const v = hy < hh && ox + x < hw ? heat[hy * hw + ox + x] : 0;
          if (v < CUT) {
            p[o + 3] = 0;
            continue;
          }
          const j = Math.min(255, (v * 255) | 0) * 4;
          p[o] = lut[j];
          p[o + 1] = lut[j + 1];
          p[o + 2] = lut[j + 2];
          p[o + 3] = lut[j + 3];
        }
      }
      vx.putImageData(img, 0, 0);
    }
    requestAnimationFrame(tick);
  };

  fit();
  new ResizeObserver(fit).observe(document.body);
  addEventListener("resize", fit);
  requestAnimationFrame(tick);

  // Testumschalter
  const sw = document.querySelector<HTMLElement>("[data-heat-switch]")!;
  sw.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (!b) return;
    if (b.hasAttribute("data-clear")) {
      heat.fill(0);
      dirty = true;
      return;
    }
    decay = DECAY[b.dataset.decay as keyof typeof DECAY];
    sw.querySelectorAll("[data-decay]").forEach((x) => x.classList.toggle("is-on", x === b));
  });

  (window as any).__heat = { get heat() { return heat; }, stamp };
</script>

<style>
  .heatmap {
    position: fixed;
    left: 0;
    top: 0;
    width: 100vw;
    /* unter dem Text, über dem Hintergrund des umgebenden Abschnitts */
    z-index: -1;
    pointer-events: none;
    /* Viertelauflösung hochskaliert plus Weichzeichner = die weichen Wolken */
    filter: blur(10px);
  }

  .heat-switch {
    position: fixed;
    left: 12px;
    bottom: 12px;
    z-index: 20;
    display: flex;
    gap: 4px;
    align-items: center;
    font-size: 11px;
    background: rgba(255, 255, 255, 0.85);
    padding: 4px 6px;
  }

  .heat-switch button {
    font: inherit;
    border: 1px solid #ccc;
    background: none;
    padding: 2px 6px;
    cursor: pointer;
  }

  .heat-switch button.is-on {
    background: #111;
    color: #fff;
    border-color: #111;
  }
</style>
