---
// Seitenübergang „Dither": Quadrate füllen den Schirm von groß nach klein, jedes
// baut sich als Punktmuster (geordnetes Bayer-Dithering) bis zur vollen Fläche auf.
// Beim Aufdecken läuft es umgekehrt, die kleinsten Quadrate zuerst.
//
// Shader nach „dither" aus codrops/interlude (MIT, Copyright (c) Codrops,
// https://github.com/codrops/interlude), hier als schlichtes WebGL ohne
// Client-Router: Ein Klick auf einen internen Link deckt die Seite zu, dann lädt
// die neue Seite normal. Ein Merker in sessionStorage sorgt dafür, dass sie
// zugedeckt startet (siehe Inline-Skript im Layout) und sich dann aufdeckt.
---

<div class="page-dither" data-page-dither aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  const LEAVE_MS = 1100; // zudecken
  const ENTER_MS = 1100; // aufdecken
  const COLOR: [number, number, number] = [0.067, 0.067, 0.067]; // #111
  const FLAG = "page-dither";

  // Wie im Original: drei Quadratgrößen auf demselben Raster (Anteil der
  // Bildschirmhöhe), je Größe ein Anteil, der überhaupt mitmacht, und ein
  // zeitlicher Versatz. Die kleinsten machen alle mit, so ist am Ende alles bedeckt.
  const FRAG = `
    precision highp float;
    uniform vec2 uRes;
    uniform float uProgress; // 0 → 1 beim Zudecken, 1 → 0 beim Aufdecken
    uniform float uReveal;   // 0 beim Zudecken, 1 beim Aufdecken (anderes Muster)
    uniform vec3 uColor;
    const float STAGGER = 0.16;
    const float FILL = 0.2;
    const float DOTS = 256.0; // Punkte pro Bildschirmhöhe, 8 je kleinstem Quadrat

    float hash(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }

    // 4×4-Bayer-Schwelle aus der 2×2-Matrix (2x + 3y) mod 4
    float bayer(vec2 d) {
      float fine = mod(mod(d.x, 2.0) * 2.0 + mod(d.y, 2.0) * 3.0, 4.0);
      float coarse = mod(mod(floor(d.x / 2.0), 2.0) * 2.0 + mod(floor(d.y / 2.0), 2.0) * 3.0, 4.0);
      return (fine * 4.0 + coarse + 0.5) / 16.0;
    }

    float level(vec2 p, float size, float share, float lv, float span) {
      vec2 cell = floor(p / size);
      float id = cell.x + cell.y * 997.0 + lv * 7919.0 + uReveal * 104729.0;
      float takesPart = step(hash(id), share);
      float moment = hash(id + 50021.0) * span + lv * STAGGER;
      return takesPart * clamp((uProgress - moment) / FILL, 0.0, 1.0);
    }

    void main() {
      vec2 p = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y) / uRes.y; // in Bildschirmhöhen
      float span = 1.0 - STAGGER * 2.0 - FILL;
      float density = level(p, 1.0 / 8.0, 0.4, 0.0, span);
      density = max(density, level(p, 1.0 / 16.0, 0.5, 1.0, span));
      density = max(density, level(p, 1.0 / 32.0, 1.0, 2.0, span));
      float a = step(bayer(floor(p * DOTS)), density);
      // bei 1 nie ein Pixel Seite, bei 0 nie ein Pixel Abdeckung
      a = uProgress >= 0.999 ? 1.0 : a * step(0.001, uProgress);
      gl_FragColor = vec4(uColor * a, a);
    }
  `;
  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2); // power1.inOut

  function init(root: HTMLElement) {
    const html = document.documentElement;
    const uncover = () => html.classList.remove("dither-cover");
    let flagged = false;
    try {
      flagged = sessionStorage.getItem(FLAG) === "1";
      sessionStorage.removeItem(FLAG);
    } catch {}

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canvas = root.querySelector("canvas") as HTMLCanvasElement;
    const gl = reduce ? null : canvas.getContext("webgl", { premultipliedAlpha: true, alpha: true, antialias: false });
    if (!gl) { uncover(); return; }

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? "shader");
      return s;
    };
    const prog = gl.createProgram()!;
    try {
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    } catch {
      uncover();
      return;
    }
    gl.linkProgram(prog);
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, "aPos");
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
    const uRes = gl.getUniformLocation(prog, "uRes");
    const uProgress = gl.getUniformLocation(prog, "uProgress");
    const uReveal = gl.getUniformLocation(prog, "uReveal");
    gl.uniform3f(gl.getUniformLocation(prog, "uColor"), ...COLOR);

    let progress = 0;
    let reveal = 0;
    const draw = () => {
      gl.uniform1f(uProgress, progress);
      gl.uniform1f(uReveal, reveal);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      if (progress > 0) gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      draw();
    };
    window.addEventListener("resize", resize);
    resize();

    // progress von jetzt bis `to`, über `ms`
    let raf = 0;
    const tween = (to: number, ms: number, done?: () => void) => {
      cancelAnimationFrame(raf);
      const from = progress;
      const t0 = performance.now();
      const step = () => {
        const u = Math.min((performance.now() - t0) / ms, 1);
        progress = from + (to - from) * ease(u);
        draw();
        if (u < 1) raf = requestAnimationFrame(step);
        else done?.();
      };
      raf = requestAnimationFrame(step);
    };

    const playReveal = () => {
      reveal = 1;
      tween(0, ENTER_MS * progress, () => { root.style.pointerEvents = ""; });
    };

    // Ankunft über einen Übergang: zugedeckt starten, dann aufdecken,
    // sobald die Schriften da sind (höchstens 400 ms warten)
    if (flagged && html.classList.contains("dither-cover")) {
      progress = 1;
      draw();
      requestAnimationFrame(() => {
        uncover(); // ab jetzt deckt das Canvas, nicht mehr die CSS-Fläche
        const fonts = document.fonts?.ready ?? Promise.resolve();
        Promise.race([fonts, new Promise((r) => setTimeout(r, 400))]).then(playReveal);
      });
    } else {
      uncover();
    }

    // Abfahrt: interne Links decken erst zu, dann lädt die neue Seite
    let leaving = false;
    document.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest?.("a");
      if (!a || !a.href) return;
      if ((a.target && a.target !== "_self") || a.hasAttribute("download") || a.hasAttribute("data-no-transition")) return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.search === location.search) return; // gleiche Seite, Anker
      e.preventDefault();
      if (leaving) return;
      leaving = true;
      root.style.pointerEvents = "auto"; // keine Doppelklicks während des Zudeckens
      reveal = 0;
      tween(1, LEAVE_MS * (1 - progress), () => {
        try { sessionStorage.setItem(FLAG, "1"); } catch {}
        location.href = url.href;
      });
    });

    // Zurück-Taste mit Seiten-Cache: Die alte Seite käme zugedeckt wieder, also aufdecken
    window.addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      leaving = false;
      try { sessionStorage.removeItem(FLAG); } catch {}
      if (progress > 0) playReveal();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-page-dither]").forEach(init);
</script>

<style>
  .page-dither {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
  }

  .page-dither canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Bis das Canvas übernimmt, deckt eine schlichte Fläche (gesetzt im Layout-Kopf) */
  :global(html.dither-cover) .page-dither {
    background: #111;
  }
</style>
