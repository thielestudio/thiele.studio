---
// Partikel-Bühne für den About-Teil. Bleibt am Bildschirm stehen, während die
// Screens darüber scrollen. Jeder Screen mit data-shape="…" bestimmt die Form,
// zwischen benachbarten Screens wird überblendet.
---

<div class="stage" data-particle-stage aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import type { Shape } from "../lib/particleShapes";

  const COUNT = 12000;
  const COLOR = "#f7f4ec";

  async function init(stage: HTMLElement) {
    const THREE = await import("three");
    const { MeshSurfaceSampler } = await import("three/examples/jsm/math/MeshSurfaceSampler.js");
    const { mergeVertices } = await import("three/examples/jsm/utils/BufferGeometryUtils.js");
    const shapes = await import("../lib/particleShapes");

    const canvas = stage.querySelector("canvas") as HTMLCanvasElement;
    const section = stage.closest("section") as HTMLElement;
    const screens = [...section.querySelectorAll<HTMLElement>("[data-shape]")];
    const noHover = window.matchMedia("(hover: none)").matches;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);
    camera.position.set(0, 0, 6);
    const group = new THREE.Group();
    scene.add(group);

    // Sichtbare Fläche auf Höhe z = 0
    const visible = () => {
      const h = 2 * camera.position.z * Math.tan((camera.fov * Math.PI) / 360);
      return { w: h * camera.aspect, h };
    };

    // Formen einmal berechnen
    let library: Record<string, Shape> = {};
    const buildLibrary = () => {
      const v = visible();
      library = {
        noise: shapes.noise(COUNT, v.w * 1.1, v.h * 1.1),
        standout: shapes.standout(COUNT),
        signal: shapes.signal(COUNT),
        system: shapes.system(COUNT),
        growth: shapes.growth(COUNT),
        dust: shapes.noise(COUNT, v.w * 1.1, v.h * 1.1, true),
        head: library.head ?? shapes.head(COUNT, THREE, MeshSurfaceSampler, mergeVertices),
      };
    };

    // Puffer, die jedes Bild neu gemischt werden
    const position = new Float32Array(COUNT * 3);
    const normal = new Float32Array(COUNT * 3);
    const emphasis = new Float32Array(COUNT);
    const rnd = new Float32Array(COUNT).map(() => Math.random());

    const geo = new THREE.BufferGeometry();
    const posAttr = new THREE.BufferAttribute(position, 3).setUsage(THREE.DynamicDrawUsage);
    const nrmAttr = new THREE.BufferAttribute(normal, 3).setUsage(THREE.DynamicDrawUsage);
    const empAttr = new THREE.BufferAttribute(emphasis, 1).setUsage(THREE.DynamicDrawUsage);
    geo.setAttribute("position", posAttr);
    geo.setAttribute("aNormal", nrmAttr);
    geo.setAttribute("aEmph", empAttr);
    geo.setAttribute("aRand", new THREE.BufferAttribute(rnd, 1));
    geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 100);

    const mat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      uniforms: {
        uTime: { value: 0 },
        uSize: { value: 15 },
        uPixelRatio: { value: renderer.getPixelRatio() },
        uDim: { value: 1 },
        uDrift: { value: 0.05 },
        uColor: { value: new THREE.Color(COLOR) },
      },
      vertexShader: `
        attribute vec3 aNormal;
        attribute float aEmph;
        attribute float aRand;
        uniform float uTime;
        uniform float uSize;
        uniform float uPixelRatio;
        uniform float uDim;
        uniform float uDrift;
        varying float vAlpha;
        void main() {
          float drift = uDrift * (0.3 + 0.7 * (1.0 - aEmph));
          vec3 pos = position + vec3(
            sin(uTime * 0.5 + aRand * 40.0),
            cos(uTime * 0.4 + aRand * 31.0),
            sin(uTime * 0.3 + aRand * 17.0)
          ) * drift;
          vec4 mv = modelViewMatrix * vec4(pos, 1.0);
          gl_Position = projectionMatrix * mv;
          gl_PointSize = uSize * uPixelRatio * (0.4 + 0.6 * aRand) * (0.75 + 0.5 * aEmph) / -mv.z;

          float hasNormal = step(0.5, length(aNormal));
          vec3 nrm = normalize(normalMatrix * (aNormal + vec3(0.0, 0.0, 1e-4)));
          float light = clamp(dot(nrm, normalize(vec3(0.45, 0.55, 0.7))), 0.0, 1.0);
          float front = smoothstep(-0.35, 0.15, nrm.z);
          float shade = mix(1.0, (0.3 + 0.7 * light) * front, hasNormal);
          vAlpha = (0.12 + 0.88 * aEmph) * shade * uDim;
        }
      `,
      fragmentShader: `
        uniform vec3 uColor;
        varying float vAlpha;
        void main() {
          float d = length(gl_PointCoord - 0.5);
          if (d > 0.5) discard;
          gl_FragColor = vec4(uColor, smoothstep(0.5, 0.1, d) * vAlpha);
        }
      `,
    });
    group.add(new THREE.Points(geo, mat));

    // Layout: auf breiten Screens stehen die Formen rechts, auf schmalen hinter dem Text
    let offsetX = 0;
    let offsetY = 0;
    let shapeScale = 1;
    let wide = true;
    const resize = () => {
      const { width, height } = stage.getBoundingClientRect();
      if (!width || !height) return;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      wide = width >= 769;
      // Breit: Formen rechts neben dem Text. Schmal: Formen im unteren Drittel, unter dem Text.
      offsetX = wide ? visible().w * 0.22 : 0;
      offsetY = wide ? 0 : -visible().h * 0.3;
      shapeScale = wide ? 1 : Math.min(1, (visible().w * 0.9) / 2.6);
      mat.uniforms.uDim.value = wide ? 1 : 0.55;
      buildLibrary();
    };
    window.addEventListener("resize", resize);
    resize();

    // Scrollposition → zwei benachbarte Formen und Mischanteil
    const smooth = (a: number, b: number, x: number) => {
      const t = Math.min(Math.max((x - a) / (b - a), 0), 1);
      return t * t * (3 - 2 * t);
    };
    const currentMix = () => {
      const mid = window.innerHeight / 2;
      const centers = screens.map((s) => {
        const r = s.getBoundingClientRect();
        return r.top + r.height / 2;
      });
      if (mid <= centers[0]) return { a: 0, b: 0, t: 0 };
      for (let i = 0; i < centers.length - 1; i++) {
        if (mid < centers[i + 1]) {
          const t = (mid - centers[i]) / (centers[i + 1] - centers[i]);
          return { a: i, b: i + 1, t: smooth(0.2, 0.8, t) };
        }
      }
      const last = centers.length - 1;
      return { a: last, b: last, t: 0 };
    };

    // Mauszeiger
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    window.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      target.y = (e.clientX / window.innerWidth - 0.5) * 2;
      target.x = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    let running = false;
    let raf = 0;
    const clock = new THREE.Clock();

    const frame = () => {
      const time = clock.getElapsedTime();
      const { a, b, t } = currentMix();
      const A = library[screens[a].dataset.shape as string];
      const B = library[screens[b].dataset.shape as string];
      const oA = A.fill ? 0 : offsetX;
      const oB = B.fill ? 0 : offsetX;
      const sA = A.fill ? 1 : shapeScale;
      const sB = B.fill ? 1 : shapeScale;
      const u = 1 - t;
      for (let i = 0; i < COUNT; i++) {
        const j = i * 3;
        position[j] = (A.positions[j] * sA + oA) * u + (B.positions[j] * sB + oB) * t;
        position[j + 1] =
          (A.positions[j + 1] * sA + (A.fill ? 0 : offsetY)) * u +
          (B.positions[j + 1] * sB + (B.fill ? 0 : offsetY)) * t;
        position[j + 2] = A.positions[j + 2] * sA * u + B.positions[j + 2] * sB * t;
        normal[j] = A.normals[j] * u + B.normals[j] * t;
        normal[j + 1] = A.normals[j + 1] * u + B.normals[j + 1] * t;
        normal[j + 2] = A.normals[j + 2] * u + B.normals[j + 2] * t;
        emphasis[i] = A.emphasis[i] * u + B.emphasis[i] * t;
      }
      posAttr.needsUpdate = true;
      nrmAttr.needsUpdate = true;
      empAttr.needsUpdate = true;

      // Formen neigen sich zum Mauszeiger, der Kopf deutlich stärker,
      // das Rauschen gar nicht
      const strength = (s: Shape, name: string) => (s.fill ? 0 : name === "head" ? 1 : 0.3);
      const k =
        strength(A, screens[a].dataset.shape as string) * u +
        strength(B, screens[b].dataset.shape as string) * t;
      if (noHover) {
        target.y = Math.sin(time * 0.3) * 0.6;
        target.x = Math.sin(time * 0.2) * 0.15;
      }
      current.x += (target.x - current.x) * 0.05;
      current.y += (target.y - current.y) * 0.05;
      // Drehung um die Formmitte, nicht um die Bildmitte
      const pivot = offsetX * (1 - (A.fill ? u : 0) - (B.fill ? t : 0));
      const pivotY = offsetY * (1 - (A.fill ? u : 0) - (B.fill ? t : 0));
      group.position.set(pivot, pivotY, 0);
      group.rotation.set(current.x * 0.25 * k, current.y * 0.55 * k, 0);
      group.children[0].position.set(-pivot, -pivotY, 0);

      mat.uniforms.uDrift.value = A.drift * u + B.drift * t;
      mat.uniforms.uTime.value = time;
      renderer.render(scene, camera);
      if (running) raf = requestAnimationFrame(frame);
    };

    // Nur rechnen, solange der About-Teil im Bild ist
    new IntersectionObserver((entries) => {
      const on = entries.some((e) => e.isIntersecting);
      if (on && !running) {
        running = true;
        raf = requestAnimationFrame(frame);
      } else if (!on) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }).observe(section);
  }

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-particle-stage]").forEach((stage) => {
    if (reduce) {
      stage.style.display = "none";
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init(stage);
        }
      },
      { rootMargin: "800px 0px" }
    );
    io.observe(stage.closest("section") ?? stage);
  });
</script>

<style>
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    pointer-events: none;
    z-index: 0;
  }

  .stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
